    "outDir": "dist",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "vite/client"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "src/**/*.json"
  ],
  "references": [
